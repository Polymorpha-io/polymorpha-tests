{
  "name": "polymorpha",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run prebuild && npm run test && tsc -b && vite build",
    "prebuild": "node -e \"try{require('fs').rmSync('dist/client',{recursive:true,force:true})}catch(e){};try{require('fs').rmSync('.wrangler/deploy',{recursive:true,force:true})}catch(e){}\"",
    "typecheck": "tsc -b",
    "test": "npm run test:ui && npm run test:backend",
    "test:ui": "echo ======================================== && echo  POLYMORPHA UI TEST SUITE && echo ======================================== && vitest run --reporter=verbose && echo \"\" && echo [telemetry] source=ui event=suite_end status=passed || echo [telemetry] source=ui event=suite_end status=failed",
    "test:backend": "node scripts/test-backend.mjs",
    "test:central": "node -e \"const fs=require('fs'),cp=require('child_process');const g='node_modules/@polymorpha/tests/scripts/sync.mjs';if(!fs.existsSync(g)){console.error('[central] not found: run npm install');process.exit(1);}console.log('[polymorpha] delegating to central registry '+g+' (G22)');cp.execSync('node \\\"'+g+'\\\" --check',{stdio:'inherit'});cp.execSync('npm --prefix \\\"node_modules/@polymorpha/tests\\\" run test:ui',{stdio:'inherit'});\"",
    "test:central:all": "node -e \"const fs=require('fs'),cp=require('child_process');const g='node_modules/@polymorpha/tests/scripts/sync.mjs';if(!fs.existsSync(g)){console.error('[central] not found');process.exit(1);}cp.execSync('node \\\"'+g+'\\\" --check',{stdio:'inherit'});cp.execSync('npm --prefix \\\"node_modules/@polymorpha/tests\\\" run test:all',{stdio:'inherit'});\"",
    "test:central:github": "node ./node_modules/@polymorpha/tests/scripts/sync.mjs --check && npm --prefix ./node_modules/@polymorpha/tests run test:ui",
    "test:central:e2e": "node ./node_modules/@polymorpha/tests/scripts/sync.mjs --check && npm --prefix ./node_modules/@polymorpha/tests run test:e2e",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:fast": "npm run prebuild && tsc -b && vite build",
    "test:fast": "vitest run --reporter=dot --changed",
    "test:unit": "vitest run --reporter=dot tests/unit",
    "test:ui:basic": "vitest run --reporter=dot",
    "test:py-fast": "python -m pytest node_modules/@polymorpha/business-logic/python -q --tb=line -x",
    "backend:check": "python3 -c \"import sys; print('python', sys.version.split()[0])\" && (python3 -c \"import polymorpha; print('[ok] polymorpha at', polymorpha.__file__)\" || echo '[warn] polymorpha wheel not importable — run npm install or pip install wheel') && (curl -s -o /dev/null -m 2 http://127.0.0.1:8080/ && echo '[ok] backend :8080 reachable' || echo '[warn] backend :8080 not reachable — start via ./dev.sh')",
    "lint": "eslint .",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@polymorpha/business-logic": "github:Polymorpha-io/polymorpha-business-logic#main",
    "@polymorpha/stella": "git+https://github.com/Polymorpha-io/polymorpha-stella.git#main",
    "@polymorpha/tests": "git+https://github.com/Polymorpha-io/polymorpha-tests.git#main",
    "@radix-ui/react-dialog": "^1.1.19",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xenova/transformers": "^2.17.2",
    "@xyflow/react": "^12.11.2",
    "ag-grid-community": "^36.0.1",
    "ag-grid-react": "^36.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "dompurify": "^3.4.5",
    "fflate": "^0.8.3",
    "firebase": "^12.13.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.23.0",
    "monaco-editor": "^0.52.2",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "pdfmake": "^0.3.11",
    "plotly.js": "^3.7.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-dropzone": "^17.0.0",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^7.15.1",
    "react-syntax-highlighter": "^16.1.1",
    "react-textarea-autosize": "^8.5.9",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.19.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/workers-types": "^4.20260521.1",
    "@eslint/js": "^10.0.1",
    "@mermaid-js/mermaid-cli": "^11.15.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.12.3",
    "@types/papaparse": "^5.5.2",
    "@types/plotly.js": "^3.0.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-plotly.js": "^2.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.6",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "shadcn": "^4.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.6",
    "wrangler": "^4.92.0"
  }
}
