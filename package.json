{
  "name": "@polymorpha/tests",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "Central test registry for Polymorpha ecosystem — library for @polymorpha/business-logic, @polymorpha/stella and polymorpha (GitHub-only, no local fallback G15/G15b)",
  "license": "MIT",
  "exports": {
    "./suites/*": "./suites/*",
    "./fixtures/*": "./fixtures/*",
    "./generators/*": "./suites/polymorpha/tests/generators/*"
  },
  "files": [
    "suites/",
    "fixtures/",
    "scripts/",
    "vite.config.ts",
    "playwright.config.ts"
  ],
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "test": "npm run test:all",
    "test:all": "npm run test:ui && npm run test:api && npm run test:python && npm run test:stella",
    "test:ui": "vitest run --reporter=verbose",
    "test:api": "vitest run --config vite.api.config.ts --reporter=verbose",
    "test:e2e": "playwright test",
    "test:python": "python -m pytest suites/business-logic/python -v --tb=short",
    "test:stella": "python -m pytest suites/stella/python -v --tb=short && npx vitest run suites/stella/unit --reporter=verbose",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"suites/**/*.{ts,tsx,py}\" \"scripts/**/*.{js,mjs}\"",
    "format:check": "prettier --check \"suites/**/*.{ts,tsx,py}\" \"scripts/**/*.{js,mjs}\"",
    "build": "tsc -b --noEmit",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "@polymorpha/business-logic": "git+https://github.com/Polymorpha-io/polymorpha-business-logic.git#main",
    "@polymorpha/stella": "git+https://github.com/Polymorpha-io/polymorpha-stella.git#main"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "typescript": "^5.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.6"
  }
}
