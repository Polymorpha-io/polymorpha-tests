{
  "name": "polymorpha-tests",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Central test registry for Polymorpha ecosystem (polymorpha + business-logic) — GitHub-only sync",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "test": "npm run test:all",
    "test:all": "npm run test:ui && npm run test:api && npm run test:python",
    "test:ui": "vitest run --reporter=verbose",
    "test:api": "vitest run --config vite.api.config.ts --reporter=verbose",
    "test:e2e": "playwright test",
    "test:python": "python -m pytest suites/business-logic/python -v --tb=short",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"suites/**/*.{ts,tsx,py}\" \"scripts/**/*.{js,mjs}\"",
    "format:check": "prettier --check \"suites/**/*.{ts,tsx,py}\" \"scripts/**/*.{js,mjs}\"",
    "build": "tsc -b --noEmit",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@polymorpha/business-logic": "git+https://github.com/Polymorpha-io/polymorpha-business-logic.git#main",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xenova/transformers": "^2.17.2",
    "@xyflow/react": "^12.11.3",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "dompurify": "^3.4.14",
    "fflate": "^0.8.3",
    "firebase": "^12.18.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.33.0",
    "monaco-editor": "^0.56.0",
    "next-themes": "^0.4.6",
    "papaparse": "^5.6.0",
    "pdfmake": "^0.3.11",
    "plotly.js": "^3.7.0",
    "react-dropzone": "^20.1.1",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^4.1.0",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "react-textarea-autosize": "^8.5.9",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.6"
  }
}
